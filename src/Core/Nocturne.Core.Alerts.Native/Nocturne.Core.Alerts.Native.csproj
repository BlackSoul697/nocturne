<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Description>P/Invoke bindings for the nocturne_alerts Rust library (crates/nocturne-alerts-ffi)</Description>
    </PropertyGroup>

    <!-- The crate version this binding was built against, stamped into the assembly so
         AlertsInterop.Probe rejects a native library from another version. -->
    <PropertyGroup>
        <NocturneAlertsFfiCargoToml>$(MSBuildThisFileDirectory)..\..\..\crates\nocturne-alerts-ffi\Cargo.toml</NocturneAlertsFfiCargoToml>
        <_NocturneAlertsVersionLine>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(NocturneAlertsFfiCargoToml)')), '(?m)^version\s*=\s*"[^"]+"').Value)</_NocturneAlertsVersionLine>
        <NocturneAlertsExpectedVersion>$([System.Text.RegularExpressions.Regex]::Replace('$(_NocturneAlertsVersionLine)', '^version\s*=\s*"|"$', ''))</NocturneAlertsExpectedVersion>
    </PropertyGroup>
    <Target Name="CheckNocturneAlertsExpectedVersion" BeforeTargets="BeforeBuild">
        <Error Condition="'$(NocturneAlertsExpectedVersion)' == ''"
               Text="Could not read the package version from $(NocturneAlertsFfiCargoToml)." />
    </Target>
    <ItemGroup>
        <InternalsVisibleTo Include="Nocturne.Alerts.Native.Tests" />
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>NocturneAlertsExpectedVersion</_Parameter1>
            <_Parameter2>$(NocturneAlertsExpectedVersion)</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>

    <!-- Native library deployment, mirroring Nocturne.Core.Oref: pack the cdylib from the
         cargo workspace target dir (or $(NocturneAlertsNativeDir) override) into
         runtimes/{rid}/native when it has been built. At runtime AlertsInterop also probes
         the NOCTURNE_ALERTS_NATIVE_DIR environment variable, so a freshly built library can
         be picked up without rebuilding this project. -->
    <PropertyGroup>
        <_NocturneAlertsNativeDirDefaulted Condition="'$(NocturneAlertsNativeDir)' == ''">true</_NocturneAlertsNativeDirDefaulted>
        <NocturneAlertsNativeDir Condition="'$(NocturneAlertsNativeDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\crates\target\release\</NocturneAlertsNativeDir>
        <!-- Cross-compiled cargo outputs land under target/<triple>/release; CI builds
             aarch64 alongside the host build so multi-arch container publishes can pack
             a native library for every RID in the manifest. -->
        <NocturneAlertsCargoTargetRoot Condition="'$(NocturneAlertsCargoTargetRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\crates\target\</NocturneAlertsCargoTargetRoot>
    </PropertyGroup>
    <ItemGroup Condition="Exists('$(NocturneAlertsNativeDir)nocturne_alerts.dll')">
        <Content Include="$(NocturneAlertsNativeDir)nocturne_alerts.dll" Link="runtimes\win-x64\native\nocturne_alerts.dll">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
    <ItemGroup Condition="Exists('$(NocturneAlertsNativeDir)libnocturne_alerts.so')">
        <Content Include="$(NocturneAlertsNativeDir)libnocturne_alerts.so" Link="runtimes\linux-x64\native\libnocturne_alerts.so">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
    <!-- A locally built dylib matches the host architecture; expose it under both osx
         RIDs and let the AlertsInterop resolver load whichever one actually matches. -->
    <ItemGroup Condition="Exists('$(NocturneAlertsNativeDir)libnocturne_alerts.dylib')">
        <Content Include="$(NocturneAlertsNativeDir)libnocturne_alerts.dylib" Link="runtimes\osx-x64\native\libnocturne_alerts.dylib">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="$(NocturneAlertsNativeDir)libnocturne_alerts.dylib" Link="runtimes\osx-arm64\native\libnocturne_alerts.dylib">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
    <ItemGroup Condition="Exists('$(NocturneAlertsCargoTargetRoot)aarch64-unknown-linux-gnu\release\libnocturne_alerts.so')">
        <Content Include="$(NocturneAlertsCargoTargetRoot)aarch64-unknown-linux-gnu\release\libnocturne_alerts.so" Link="runtimes\linux-arm64\native\libnocturne_alerts.so">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <!-- A developer build without Rust: when there is no local cargo build at least as new as
         every crates/ source, and crates/ has no uncommitted changes, download the library that
         main published for this exact crates/ tree (.github/workflows/alerts-native-publish.yml)
         and pack it for the host RID instead. Never in CI, never for another RID, and never when
         the caller names NocturneAlertsNativeDir (image builds), so what is tested and shipped is
         built from source. NocturneAlertsDownload=false turns it off. -->
    <PropertyGroup>
        <NocturneAlertsRepository Condition="'$(NocturneAlertsRepository)' == ''">nightscout/nocturne</NocturneAlertsRepository>
        <_NocturneAlertsCratesRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\crates'))</_NocturneAlertsCratesRoot>
        <_NocturneAlertsHostRid>$(NETCoreSdkRuntimeIdentifier)</_NocturneAlertsHostRid>
        <_NocturneAlertsHostFile Condition="$(_NocturneAlertsHostRid.StartsWith('win'))">nocturne_alerts.dll</_NocturneAlertsHostFile>
        <_NocturneAlertsHostFile Condition="$(_NocturneAlertsHostRid.StartsWith('linux'))">libnocturne_alerts.so</_NocturneAlertsHostFile>
        <_NocturneAlertsHostFile Condition="$(_NocturneAlertsHostRid.StartsWith('osx'))">libnocturne_alerts.dylib</_NocturneAlertsHostFile>
        <_NocturneAlertsHostExtension>$([System.IO.Path]::GetExtension('$(_NocturneAlertsHostFile)'))</_NocturneAlertsHostExtension>
    </PropertyGroup>

    <UsingTask TaskName="NocturneAlertsLocalBuildIsFresh" TaskFactory="RoslynCodeTaskFactory"
               AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <Library ParameterType="System.String" Required="true" />
            <CratesRoot ParameterType="System.String" Required="true" />
            <Fresh ParameterType="System.Boolean" Output="true" />
        </ParameterGroup>
        <Task>
            <Using Namespace="System.IO" />
            <Using Namespace="System.Linq" />
            <Code Type="Fragment" Language="cs"><![CDATA[
var target = Path.Combine(CratesRoot, "target") + Path.DirectorySeparatorChar;
Fresh = File.Exists(Library) && !Directory
    .EnumerateFiles(CratesRoot, "*", SearchOption.AllDirectories)
    .Where(f => !f.StartsWith(target, StringComparison.OrdinalIgnoreCase))
    .Where(f => f.EndsWith(".rs") || f.EndsWith("Cargo.toml") || f.EndsWith("Cargo.lock"))
    .Any(f => File.GetLastWriteTimeUtc(f) > File.GetLastWriteTimeUtc(Library));
]]></Code>
        </Task>
    </UsingTask>

    <Target Name="ResolvePrebuiltNocturneAlerts" BeforeTargets="AssignTargetPaths"
            Condition="'$(CI)' != 'true' and '$(_NocturneAlertsNativeDirDefaulted)' == 'true' and '$(NocturneAlertsDownload)' != 'false' and '$(_NocturneAlertsHostFile)' != '' and ('$(RuntimeIdentifier)' == '' or '$(RuntimeIdentifier)' == '$(_NocturneAlertsHostRid)')">
        <NocturneAlertsLocalBuildIsFresh Library="$(NocturneAlertsNativeDir)$(_NocturneAlertsHostFile)" CratesRoot="$(_NocturneAlertsCratesRoot)">
            <Output TaskParameter="Fresh" PropertyName="_NocturneAlertsLocalFresh" />
        </NocturneAlertsLocalBuildIsFresh>

        <Exec Condition="'$(_NocturneAlertsLocalFresh)' != 'true'" Command="git status --porcelain -- ."
              WorkingDirectory="$(_NocturneAlertsCratesRoot)" ConsoleToMSBuild="true" IgnoreExitCode="true"
              StandardOutputImportance="low" StandardErrorImportance="low">
            <Output TaskParameter="ConsoleOutput" PropertyName="_NocturneAlertsCratesChanges" />
            <Output TaskParameter="ExitCode" PropertyName="_NocturneAlertsGitStatusExit" />
        </Exec>
        <Exec Condition="'$(_NocturneAlertsLocalFresh)' != 'true' and '$(_NocturneAlertsGitStatusExit)' == '0' and '$(_NocturneAlertsCratesChanges)' == ''"
              Command="git rev-parse HEAD:crates" WorkingDirectory="$(_NocturneAlertsCratesRoot)\.."
              ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
            <Output TaskParameter="ConsoleOutput" PropertyName="_NocturneAlertsTree" />
            <Output TaskParameter="ExitCode" PropertyName="_NocturneAlertsTreeExit" />
        </Exec>

        <PropertyGroup Condition="'$(_NocturneAlertsTreeExit)' == '0'">
            <_NocturneAlertsPrebuiltDir>$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)alerts-native\$(_NocturneAlertsTree)\</_NocturneAlertsPrebuiltDir>
            <_NocturneAlertsPrebuilt>$(_NocturneAlertsPrebuiltDir)$(_NocturneAlertsHostFile)</_NocturneAlertsPrebuilt>
            <_NocturneAlertsPrebuiltUrl>https://github.com/$(NocturneAlertsRepository)/releases/download/alerts-native/nocturne_alerts-$(_NocturneAlertsTree)-$(_NocturneAlertsHostRid)$(_NocturneAlertsHostExtension)</_NocturneAlertsPrebuiltUrl>
        </PropertyGroup>
        <DownloadFile Condition="'$(_NocturneAlertsPrebuilt)' != '' and !Exists('$(_NocturneAlertsPrebuilt)')"
                      SourceUrl="$(_NocturneAlertsPrebuiltUrl)" DestinationFolder="$(_NocturneAlertsPrebuiltDir)"
                      DestinationFileName="$(_NocturneAlertsHostFile)" ContinueOnError="WarnAndContinue" />

        <ItemGroup Condition="'$(_NocturneAlertsPrebuilt)' != '' and Exists('$(_NocturneAlertsPrebuilt)')">
            <Content Remove="@(Content)" Condition="$([System.String]::Copy('%(Content.Link)').StartsWith('runtimes\$(_NocturneAlertsHostRid)\native\'))" />
            <Content Include="$(_NocturneAlertsPrebuilt)" Link="runtimes\$(_NocturneAlertsHostRid)\native\$(_NocturneAlertsHostFile)">
                <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            </Content>
        </ItemGroup>
        <Message Importance="high" Condition="'$(_NocturneAlertsPrebuilt)' != '' and Exists('$(_NocturneAlertsPrebuilt)')"
                 Text="nocturne_alerts: using the library main published for crates tree $(_NocturneAlertsTree)" />
        <Warning Condition="'$(_NocturneAlertsLocalFresh)' != 'true' and !('$(_NocturneAlertsPrebuilt)' != '' and Exists('$(_NocturneAlertsPrebuilt)'))"
                 Text="nocturne_alerts: no current library for this build. crates/ has local changes, or main has not published this crates/ tree yet. Install Rust (https://rustup.rs) and run 'cargo build --release -p nocturne-alerts-ffi' in crates/; the API will not start without it." />
    </Target>
</Project>
