<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <!-- The generator drives the live C# alert engine; it must never be treated as a test
             project itself (the corpus it emits is consumed by the Rust/.NET/Kotlin parity suites). -->
        <IsTestProject>false</IsTestProject>
        <NoWarn>$(NoWarn);NU1608;NU1605</NoWarn>
        <!-- Skip the NSwag/Zod/remote-codegen post-build pipeline that hangs off the API project. -->
        <GenerateNSwagClient>false</GenerateNSwagClient>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\..\src\API\Nocturne.API\Nocturne.API.csproj" />
    </ItemGroup>
</Project>
